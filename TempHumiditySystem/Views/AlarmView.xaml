<UserControl x:Class="TempHumiditySystem.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 实时报警 -->
        <GroupBox Grid.Row="0" Header="实时报警" Padding="8" Margin="0,0,0,6">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="全部确认" HorizontalAlignment="Right"
                        Margin="4" Command="{Binding AcknowledgeAllCommand}"/>
                <ListBox ItemsSource="{Binding ActiveAlarms}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="确认" Margin="8,0,0,0"
                                        Command="{Binding DataContext.AcknowledgeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- 历史报警 -->
        <GroupBox Grid.Row="1" Header="历史报警" Padding="8" Margin="0,6,0,0">
            <ListBox ItemsSource="{Binding HistoryAlarms}"/>
        </GroupBox>
    </Grid>
</UserControl>
