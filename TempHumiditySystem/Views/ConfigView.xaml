<UserControl x:Class="TempHumiditySystem.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <!-- 顶部：标题 + 全局操作 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="参数配置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="保存" Width="80" Margin="24,0,0,0" Command="{Binding SaveCommand}"/>
            <Button Content="重新加载" Width="88" Margin="8,0,0,0" Command="{Binding ReloadCommand}"/>
            <TextBlock Text="当前目录：" Margin="24,0,0,0" Foreground="#666" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ConfigDirectory}"
                       MaxWidth="320"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ConfigDirectory}"
                       Foreground="#333"
                       VerticalAlignment="Center"/>
            <Button Content="选择目录" Width="80" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}"/>
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" Foreground="#666" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl>
            <!-- ============ 测点配置 ============ -->
            <TabItem Header="测点配置">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加测点" Command="{Binding AddSensorCommand}"/>
                        <Button Content="删除选中" Margin="8,0,0,0" Command="{Binding DeleteSensorCommand}"/>
                        <TextBlock Text="提示：保存后重启生效" Foreground="#999" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Sensors}"
                              SelectedItem="{Binding SelectedSensor}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Width="110" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="分组" Width="90" Binding="{Binding GroupName}"/>
                            <DataGridTextColumn Header="从站" Width="60" Binding="{Binding SlaveId}"/>
                            <DataGridTextColumn Header="寄存器地址" Width="90" Binding="{Binding RegisterAddress}"/>
                            <DataGridTemplateColumn Header="数据类型" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataType}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="系数" Width="60" Binding="{Binding Scale}"/>
                            <DataGridTextColumn Header="单位" Width="50" Binding="{Binding Unit}"/>
                            <DataGridTemplateColumn Header="类别" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上限" Width="70" Binding="{Binding HighLimit, StringFormat=F1}"/>
                            <DataGridTextColumn Header="下限" Width="70" Binding="{Binding LowLimit, StringFormat=F1}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ 设备配置 ============ -->
            <TabItem Header="设备配置">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加设备" Command="{Binding AddDeviceCommand}"/>
                        <Button Content="删除选中" Margin="8,0,0,0" Command="{Binding DeleteDeviceCommand}"/>
                        <TextBlock Text="提示：保存后重启生效" Foreground="#999" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Width="100" Binding="{Binding Name}"/>
                            <DataGridTemplateColumn Header="类型" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DeviceTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="从站" Width="60" Binding="{Binding SlaveId}"/>
                            <DataGridTextColumn Header="写地址" Width="80" Binding="{Binding WriteAddress}"/>
                            <DataGridTextColumn Header="关联测点" Width="110" Binding="{Binding LinkedSensorName}"/>
                            <DataGridTextColumn Header="开启值" Width="70" Binding="{Binding OnAt, StringFormat=F1}"/>
                            <DataGridTextColumn Header="关闭值" Width="70" Binding="{Binding OffAt, StringFormat=F1}"/>
                            <DataGridCheckBoxColumn Header="低于开启值启动" Width="120" Binding="{Binding TurnsOnBelow}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
