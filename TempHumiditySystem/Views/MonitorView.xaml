<UserControl x:Class="TempHumiditySystem.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 测点卡片 -->
            <RowDefinition Height="Auto"/>   <!-- 设备状态 -->
            <RowDefinition Height="*"/>      <!-- 报警摘要 -->
        </Grid.RowDefinitions>

        <!-- 测点卡片 -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="190" Margin="6" Padding="14"
                            BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding GroupName}" FontSize="15" FontWeight="Bold"/>

                            <TextBlock Text="温度" Foreground="Gray" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Temperature.CurrentValue, StringFormat={}{0:F1}}"
                                           FontSize="28" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Temperature.IsAlarming}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Temperature.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                            </StackPanel>

                            <TextBlock Text="湿度" Foreground="Gray" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Humidity.CurrentValue, StringFormat={}{0:F1}}"
                                           FontSize="28" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Humidity.IsAlarming}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Humidity.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 设备状态 -->
        <GroupBox Grid.Row="1" Header="设备状态" Margin="6,12,6,6" Padding="8">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" Padding="10,6" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TypeName}" Foreground="Gray" Margin="0,0,8,0"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="● 停止"/>
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="● 运行"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- 报警摘要 -->
        <GroupBox Grid.Row="2" Header="活跃报警" Margin="6,0,6,6" Padding="8">
            <ListBox ItemsSource="{Binding ActiveAlarms}" BorderThickness="0"/>
        </GroupBox>
    </Grid>
</UserControl>
