<UserControl x:Class="TempHumiditySystem.Views.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 说明 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="趋势曲线" FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="{Binding WindowText}" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 图表卡片 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <lvc:CartesianChart
                Series="{Binding Series}"
                XAxes="{Binding XAxes}"
                YAxes="{Binding YAxes}"
                DrawMarginFrame="{Binding DrawMarginFrame}"
                LegendPosition="Bottom"
                LegendTextSize="12"
                TooltipPosition="Top"
                ZoomMode="X"
                AnimationsSpeed="0:0:0.2"/>
        </Border>
    </Grid>
    </Grid>
</UserControl>
