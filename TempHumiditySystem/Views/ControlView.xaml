<UserControl x:Class="TempHumiditySystem.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modbus="clr-namespace:TempHumiditySystem.Models.ModBus">
    <StackPanel Margin="16">
        <TextBlock Text="设备控制" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="12,10" BorderBrush="#DDDDDD"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TypeName}"
                                       Foreground="Gray" VerticalAlignment="Center"/>

                            <!-- 运行状态 -->
                            <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="● 停止"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="● 运行"/>
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 当前模式：切自动/手动后这里立即变色，作为直观反馈 -->
                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="手动"/>
                                        <Setter Property="Foreground" Value="#E67E22"/>
                                        <Style.Triggers>
                                            <!-- 枚举用 x:Static 匹配，避免字符串 "Auto" 转换不生效 -->
                                            <DataTrigger Binding="{Binding Mode}"
                                                         Value="{x:Static modbus:ControlMode.Auto}">
                                                <Setter Property="Text" Value="自动"/>
                                                <Setter Property="Foreground" Value="#2C6FBB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 手动开关：仅手动模式可用 -->
                                <Button Content="开/关" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ToggleDeviceCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}"
                                                             Value="{x:Static modbus:ControlMode.Auto}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 切自动：已是自动时禁用 -->
                                <Button Content="切自动" Margin="8,0,0,0"
                                        Command="{Binding DataContext.SetAutoCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}"
                                                             Value="{x:Static modbus:ControlMode.Auto}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 切手动：已是手动时禁用（补上回到手动的入口，避免切自动后无法操作） -->
                                <Button Content="切手动" Margin="8,0,0,0"
                                        Command="{Binding DataContext.SetManualModeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}"
                                                             Value="{x:Static modbus:ControlMode.Manual}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
