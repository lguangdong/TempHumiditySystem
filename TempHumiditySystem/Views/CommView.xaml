<UserControl x:Class="TempHumiditySystem.Views.CommView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <TextBlock Text="串口配置" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="串口：" Width="80" VerticalAlignment="Center"/>
            <ComboBox Width="140" IsEditable="True"
                      ItemsSource="{Binding Ports}"
                      Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="波特率：" Width="80" VerticalAlignment="Center"/>
            <ComboBox Width="140" ItemsSource="{Binding BaudRates}"
                      SelectedItem="{Binding BaudRate}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="校验位：" Width="80" VerticalAlignment="Center"/>
            <ComboBox Width="140" ItemsSource="{Binding Parities}"
                      SelectedItem="{Binding Parity}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="停止位：" Width="80" VerticalAlignment="Center"/>
            <ComboBox Width="140" ItemsSource="{Binding StopBitsOptions}"
                      SelectedItem="{Binding StopBits}"/>
        </StackPanel>

        <Button Width="120" HorizontalAlignment="Left" Command="{Binding ConnectCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="连接"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter Property="Content" Value="断开"/>
                        </DataTrigger>
                        <!-- 放后面，优先级更高：断开过程中覆盖上面的文案 -->
                        <DataTrigger Binding="{Binding IsStopping}" Value="True">
                            <Setter Property="Content" Value="断开中…"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 断开等待期间的转圈指示 -->
        <ProgressBar Width="120" Height="6" Margin="0,8,0,0" HorizontalAlignment="Left"
                     IsIndeterminate="True">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStopping}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <TextBlock Text="{Binding StatusText}" Margin="0,20,0,0" Foreground="Gray" FontSize="14"/>
    </StackPanel>
</UserControl>
