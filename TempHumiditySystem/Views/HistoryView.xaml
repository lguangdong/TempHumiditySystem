<UserControl x:Class="TempHumiditySystem.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="历史数据" FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="每 1 秒采样一次，内存保留最近 24 小时；所有测点都离线的时刻不会写入记录。"
                       FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 统计卡片 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="有效数据条数" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding SampleCount}" FontSize="26" FontWeight="SemiBold"
                               Foreground="#111827" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="时间范围" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding TimeRangeText}" FontSize="14" Foreground="#374151"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 导出区 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="导出 CSV" Width="100" Height="30" Command="{Binding ExportCommand}"/>
                    <Button Content="打开最近导出目录" Width="132" Height="30" Margin="8,0,0,0"
                            Command="{Binding OpenExportFolderCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="最近导出：" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding LastExportText}" FontSize="12" Foreground="#6B7280"
                               MaxWidth="700" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LastExportPath}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#374151"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
