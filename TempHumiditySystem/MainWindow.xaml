<Window x:Class="TempHumiditySystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TempHumiditySystem.ViewModels"
        xmlns:views="clr-namespace:TempHumiditySystem.Views"
        Title="温湿度采集控制系统"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶栏 -->
            <RowDefinition Height="*"/>      <!-- 主体 -->
            <RowDefinition Height="Auto"/>   <!-- 底栏 -->
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0" Background="#2C6FBB" Padding="16,10">
            <Grid>
                <TextBlock Text="温湿度采集控制系统"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFB74D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="White" Margin="0,0,24,0"/>
                    <TextBlock Foreground="White">
                        <Run Text="报警数："/><Run Text="{Binding ActiveAlarmCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体：左侧菜单 + 内容区 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧菜单 -->
            <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Margin="8,2" Padding="14,10"
                                    HorizontalContentAlignment="Left"
                                    BorderThickness="3,0,0,0"
                                    Cursor="Hand"
                                    FontSize="14"
                                    Command="{Binding DataContext.NavigateCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#444444"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <!-- 自定义模板：去掉系统按钮的悬停/按下 Chrome，让高亮完全由下面触发器控制 -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="Center"
                                                            Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- 悬停反馈（声明在选中触发器之前：两者同时命中时，后声明的选中态优先） -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EDF1F5"/>
                                            </Trigger>
                                            <!-- 选中态：左侧蓝色竖条 + 浅蓝底 + 蓝字加粗 -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#E3F0FB"/>
                                                <Setter Property="Foreground" Value="#2C6FBB"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="BorderBrush" Value="#2C6FBB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 内容区：根据 CurrentViewModel 类型自动匹配 View -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"
                            Margin="16">
                <ContentControl.Resources>
                    <!-- 占位模板：后续替换成 <views:MonitorView/> 等真实页面 -->
                    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                        <views:MonitorView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TrendViewModel}">
                        <views:TrendView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AlarmViewModel}">
                        <views:AlarmView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ControlViewModel}">
                        <views:ControlView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
                        <views:ConfigView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CommViewModel}">
                        <views:CommView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Border Grid.Row="2" Background="#F5F6F8" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="16,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SerialConfigText}" Foreground="#888"/>
                <TextBlock Text="{Binding PollIntervalText}" Foreground="#888" Margin="32,0,0,0"/>
                <TextBlock Foreground="#888" Margin="32,0,0,0">
                    <Run Text="在线测点数："/><Run Text="{Binding OnlineSensorCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Version}" Foreground="#BBB" Margin="32,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
