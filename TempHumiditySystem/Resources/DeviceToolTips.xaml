<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设备控制参数的悬停提示：实时监控页与设备控制页共用 -->
    <DataTemplate x:Key="DeviceToolTipTemplate">
        <StackPanel MinWidth="210">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="类型" Foreground="#888"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeName}"/>

                <TextBlock Grid.Row="1" Text="关联测点" Foreground="#888"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinkedSensorText}"/>

                <TextBlock Grid.Row="2" Text="当前模式" Foreground="#888"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModeText}"/>

                <TextBlock Grid.Row="3" Text="开启值" Foreground="#888"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding OnAt, StringFormat={}{0:0.#}}"/>

                <TextBlock Grid.Row="4" Text="关闭值" Foreground="#888"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding OffAt, StringFormat={}{0:0.#}}"/>
            </Grid>
            <Border Height="1" Background="#EEEEEE" Margin="0,8,0,6"/>
            <TextBlock Text="{Binding ControlRuleText}" Foreground="#444" TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
